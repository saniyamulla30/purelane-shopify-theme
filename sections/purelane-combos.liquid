{{ 'section-combos.css' | asset_url | stylesheet_tag }}

<section class="sec" id="combos" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    {%- assign combos = shop.metaobjects.combo.values -%}

    {%- if combos.size == 0 -%}
      {%- if request.design_mode -%}
        <div class="glass sec-pad" style="text-align:center">
          <p>Add a few "Combo" entries under Content → Metaobjects to show them here.</p>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="comborail rv">
        {%- for combo in combos -%}
          {%- assign combo_price = combo.combo_price.value | round -%}
          {%- assign compare_price = combo.compare_at_price.value | round -%}
          {%- assign save_amount = compare_price | minus: combo_price -%}
          {%- assign products = combo.products.value -%}

          <article class="glass combo{% if combo.featured.value %} hero-combo{% endif %}">
            <div class="tray">
              <span class="save">You save ₹{{ save_amount }}</span>
              {%- if combo.badge_text.value != blank -%}
                <span class="flag">{{ combo.badge_text.value }}</span>
              {%- endif -%}
              <div class="stack">
                {%- for product in products -%}
                  <span class="it">
                    {%- if product.featured_image != blank -%}
                       <img 
                        class="pimg"
                        src="{{ product.featured_image | image_url: width: 100 }}"
                        alt="{{ product.featured_image.alt | default: product.title | escape }}"
                        width="100"
                        height="{{ 100 | divided_by: product.featured_image.aspect_ratio | default: 100 }}"
                        loading="lazy">
                    {%- else -%}
                      <span class="tile" role="img" aria-label="{{ product.title | escape }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                      </span>
                    {%- endif -%}
                    <span>{{ product.title }}</span>
                  </span>
                  {%- unless forloop.last -%}<span class="plus" aria-hidden="true">+</span>{%- endunless -%}
                {%- endfor -%}
              </div>
            </div>
            <div class="body">
              <h3>{{ combo.title.value }}</h3>
              <div class="cnt">{{ products.size }} products</div>
              <p class="inc">
                {%- capture inc_list -%}
                  {%- for product in products -%}
                    {{ product.title }}{% unless forloop.last %}{% if forloop.rindex == 2 %} &amp; {% else %}, {% endif %}{% endunless %}
                  {%- endfor -%}
                {%- endcapture -%}
                Includes: {{ inc_list | strip }}.
              </p>
              <div class="prow">
                <strong>₹{{ combo_price }}</strong>
                <s>₹{{ compare_price }}</s>
                <em>Save ₹{{ save_amount }}</em>
              </div>
              <div class="fine">Inclusive of all taxes · COD available</div>
              <a class="btn {% if combo.featured.value %}btn-primary{% else %}btn-ghost{% endif %}" href="#bundles">
                Shop bundle
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>
      <div class="swipecue" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        Swipe for more combos
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane Combos",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker text", "default": "Save more" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" }
  ],
  "presets": [
    { "name": "Purelane Combos" }
  ]
}
{% endschema %}