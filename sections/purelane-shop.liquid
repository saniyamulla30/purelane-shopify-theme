{{ 'section-shop.css' | asset_url | stylesheet_tag }}

<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    {%- assign shop_collection = section.settings.collection -%}

    {%- if shop_collection == blank or shop_collection.products.size == 0 -%}
      {%- if request.design_mode -%}
        <div class="glass sec-pad" style="text-align:center">
          <p>Select a collection in the section settings to show products here.</p>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="shelf">
        {%- for product in shop_collection.products limit: section.settings.products_to_show -%}
          <article class="glass card rv">
            <div class="shot">
              {%- if product.available == false -%}
                <span class="pill pill-sold">Sold out</span>
              {%- else -%}
                <span class="pill">{{ section.settings.badge_text }}</span>
              {%- endif -%}

              {%- if product.featured_image != blank -%}
                <img
                  class="pimg"
                  src="{{ product.featured_image | image_url: width: 400 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  width="400"
                  height="{{ 400 | divided_by: product.featured_image.aspect_ratio | default: 400 }}"
                  loading="lazy">
              {%- else -%}
                <span class="pimg pimg-placeholder" role="img" aria-label="{{ product.title | escape }}">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 3h6v4l2 2v10a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V9l2-2Z"/>
                    <path d="M9 12h6"/>
                    <path d="M9 16h6"/>
                  </svg>
                </span>
              {%- endif -%}
            </div>

            <h4>{{ product.title }}</h4>

            {%- if product.metafields.custom.rating != blank -%}
              <div class="rate">
                <b>★ {{ product.metafields.custom.rating }}</b>
                {%- if product.metafields.custom.review_count != blank %} · {{ product.metafields.custom.review_count }} reviews{% endif -%}
              </div>
            {%- endif -%}

            <div class="pr">
              <strong>{{ product.price | money }}</strong>
              {%- if product.compare_at_price > product.price -%}
                <s>{{ product.compare_at_price | money }}</s>
                <em>{{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}% off</em>
              {%- endif -%}
            </div>

            {%- if product.available -%}
              {%- form 'product', product -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button type="submit" class="btn btn-ghost btn-sm">{{ section.settings.button_text }}</button>
              {%- endform -%}
            {%- else -%}
              <button class="btn btn-ghost btn-sm" disabled>Sold out</button>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane Shop",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker text", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by thousands of homes" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "text", "id": "badge_text", "label": "Badge text (in-stock products)", "default": "Best seller" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Add to cart" }
  ],
  "presets": [
    { "name": "Purelane Shop" }
  ]
}
{% endschema %}