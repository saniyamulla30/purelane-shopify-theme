{{ 'section-bundles.css' | asset_url | stylesheet_tag }}

<section class="sec" id="bundles" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        <p class="lede" style="margin:0 auto">{{ section.settings.lede }}</p>
      </div>
    </div>

    <div class="tiers">
      {%- for block in section.blocks -%}
        {%- assign products = '' -%}
        <article class="glass tier{% if block.settings.featured %} best{% endif %} rv" {{ block.shopify_attributes }}>
          <span class="tag">{{ block.settings.tag }}</span>

          <div class="tierpix{% if block.settings.qty_number >= 5 %} five{% endif %}" aria-hidden="true">
            {%- for i in (1..5) -%}
              {%- assign product_key = 'product_' | append: i -%}
              {%- assign product = block.settings[product_key] -%}
              {%- if product != blank and product.featured_image != blank -%}
                <img
                    class="pimg"
                    src="{{ product.featured_image | image_url: width: 100 }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    width="100"
                    height="{{ 100 | divided_by: product.featured_image.aspect_ratio | default: 100 }}"
                    loading="lazy">
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="qty">{{ block.settings.qty_number }}<small>Products</small></div>
          <div class="price">{{ block.settings.price }} <s>{{ block.settings.compare_price }}</s></div>
          <p class="body-s" style="font-size:12px">{{ block.settings.per_product_note }}</p>

          <ul>
            {%- if block.settings.feature_1 != blank -%}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_1 }}</li>
            {%- endif -%}
            {%- if block.settings.feature_2 != blank -%}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_2 }}</li>
            {%- endif -%}
            {%- if block.settings.feature_3 != blank -%}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_3 }}</li>
            {%- endif -%}
          </ul>

          <a class="btn {% if block.settings.featured %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_link | default: '#shop' }}">
            {{ block.settings.button_text }}
            {%- if block.settings.featured -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            {%- endif -%}
          </a>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundles",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker text", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    { "type": "textarea", "id": "lede", "label": "Subtext", "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way." }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Pricing tier",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag label", "default": "Starter" },
        { "type": "number", "id": "qty_number", "label": "Number of products", "default": 2 },
        { "type": "text", "id": "price", "label": "Price", "default": "₹349" },
        { "type": "text", "id": "compare_price", "label": "Compare-at price", "default": "₹598" },
        { "type": "text", "id": "per_product_note", "label": "Per-product note", "default": "Flat ₹174 per product" },
        { "type": "text", "id": "feature_1", "label": "Feature 1", "default": "Pick any two products" },
        { "type": "text", "id": "feature_2", "label": "Feature 2" },
        { "type": "text", "id": "feature_3", "label": "Feature 3", "default": "Free shipping across India" },
        { "type": "text", "id": "button_text", "label": "Button text", "default": "Build this box" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "checkbox", "id": "featured", "label": "Highlight as most popular", "default": false },
        { "type": "product", "id": "product_1", "label": "Preview product 1" },
        { "type": "product", "id": "product_2", "label": "Preview product 2" },
        { "type": "product", "id": "product_3", "label": "Preview product 3" },
        { "type": "product", "id": "product_4", "label": "Preview product 4" },
        { "type": "product", "id": "product_5", "label": "Preview product 5" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        { "type": "tier" },
        { "type": "tier" },
        { "type": "tier" }
      ]
    }
  ]
}
{% endschema %}